# =====================================================================
# Plantilla de variables de entorno — Reformas Integrales Amedida (TFM)
# =====================================================================
# Copia este archivo como ".env" en la raíz del repositorio y rellena
# los valores reales. El .env real está en .gitignore y NUNCA se sube a
# git; este .env.example sí se sube, y por eso no contiene ningún valor
# real, solo ejemplos con la forma correcta.

# OBLIGATORIA. Cadena de conexión a Postgres (Supabase, Session pooler).
# Se obtiene en el panel de Supabase: Project Settings > Database >
# Connection string > Session pooler.
DATABASE_URL=postgresql://usuario:contraseña@host-del-pooler:5432/postgres

# OBLIGATORIA. Secreto compartido con n8n para autenticar POST /leads.
# n8n debe enviarlo en la cabecera HTTP "X-Webhook-Secret" (credencial
# de tipo "Header Auth" en el nodo HTTP). Si falta o está vacía, el
# servidor se niega a arrancar (comprobación en app/api/security.py).
#
# Genera un valor aleatorio seguro con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# token_urlsafe(32) produce 32 bytes aleatorios (256 bits) codificados
# en unos 43 caracteres que se pueden pegar sin problema en una cabecera
# HTTP o en un campo de n8n. El valor de abajo es solo un ejemplo: NO lo
# uses tal cual.
WEBHOOK_SECRET=cambia-esto-por-un-valor-generado-con-secrets-token-urlsafe

# OPCIONALES. Tamaño del pool de conexiones (valores por defecto en
# app/config.py: 2 y 10). Descomenta solo si necesitas cambiarlos.
# DB_POOL_MIN=2
# DB_POOL_MAX=10
